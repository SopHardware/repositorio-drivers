# ETAPA 1: Construcción (Build)
FROM node:20-alpine AS builder
WORKDIR /app

# Copiamos archivos de dependencias desde la raíz del repo
COPY package*.json ./
COPY packages/core-api/package*.json ./packages/core-api/

# Instalamos dependencias
RUN npm install

# Copiamos el código fuente de la API y Prisma
COPY packages/core-api ./packages/core-api

# Entramos a la carpeta de la API y compilamos
WORKDIR /app/packages/core-api
RUN npx prisma generate
RUN npm run build

# ETAPA 2: Ejecución (Run)
FROM node:20-alpine
WORKDIR /app

# Solo copiamos lo necesario para que el contenedor sea ligero
COPY --from=builder /app/packages/core-api/dist ./dist
COPY --from=builder /app/packages/core-api/node_modules ./node_modules
COPY --from=builder /app/packages/core-api/package*.json ./
COPY --from=builder /app/packages/core-api/prisma ./prisma

EXPOSE 5001

# Ejecutamos migraciones y arrancamos
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
