# Core API - Production Environment
# ================================

# Database
DATABASE_URL="postgresql://user:password@server:5432/database"

# JWT Secret (change in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Google Drive
GOOGLE_DRIVE_CREDENTIALS_PATH="src/config/secret/credentials.json"
GOOGLE_DRIVE_FOLDER_ID="your-folder-id-in-shared-drive"

# API Keys (change in production)
API_KEY_ADMIN_PORTAL="your-admin-api-key-change-in-production"
API_KEY_PUBLIC_REPO="your-public-api-key-change-in-production"

# Server
PORT=5001
NODE_ENV=production
