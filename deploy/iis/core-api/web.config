<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS - Reverse Proxy hacia DriversAPI (NSSM Service en puerto 5001)
  El proceso Node.js es gestionado por NSSM, no por IIS.
  Requiere: IIS URL Rewrite Module + Application Request Routing (ARR)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxy-DriversAPI" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:5001/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
